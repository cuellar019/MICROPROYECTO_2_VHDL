library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

"declaracion de constantes para el sistema"

package pkg_system is
    constant CLK_HZ        : positive := 50_000_000;
    constant DATA_WIDTH    : positive := 8;
    constant ADDR_WIDTH    : positive := 4;
    constant MEM_DEPTH     : positive := 2**ADDR_WIDTH;
    constant FILTER_CYCLES : positive := CLK_HZ / 100; -- 10 ms
    subtype data_t is std_logic_vector(DATA_WIDTH-1 downto 0);
    subtype addr_t is unsigned(ADDR_WIDTH-1 downto 0);
    subtype count_t is unsigned(ADDR_WIDTH downto 0); -- representa 0..16
    subtype seg7_t is std_logic_vector(6 downto 0);
    type memory_t is array (0 to MEM_DEPTH-1) of data_t;
    type state_t is (WAIT_EVENT, READ_ROM, WRITE_RAM, UPDATE_POINTERS);
    constant ROM_CONTENT : memory_t := (
        x"11", x"22", x"33", x"44", x"55", x"66", x"77", x"88",
        x"99", x"AA", x"BB", x"CC", x"DD", x"EE", x"F0", x"0F");
    -- Bits g,f,e,d,c,b,a. Los segmentos se encienden con '0'.
    function hex7(value : std_logic_vector(3 downto 0)) return seg7_t;
end package;

package body pkg_system is
    function hex7(value : std_logic_vector(3 downto 0)) return seg7_t is
    begin

"definicion de cada combinacion que se vera reflejada en el display 7 segmentos"

        case value is
            when x"0" => return "1000000";
            when x"1" => return "1111001";
            when x"2" => return "0100100";
            when x"3" => return "0110000";
            when x"4" => return "0011001";
            when x"5" => return "0010010";
            when x"6" => return "0000010";
            when x"7" => return "1111000";
            when x"8" => return "0000000";
            when x"9" => return "0010000";
            when x"A" => return "0001000";
            when x"B" => return "0000011";
            when x"C" => return "1000110";
            when x"D" => return "0100001";
            when x"E" => return "0000110";
            when x"F" => return "0001110";
            when others => return "0111111"; -- guion
        end case;
    end function;
end package body;
